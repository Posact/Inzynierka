<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Inżynierka </title>
    <script type="importmap"></script>

    <!-- Zmieniony Bootstrap na motyw FLATLY (Bootswatch) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootswatch@5.3.2/dist/flatly/bootstrap.min.css" />
    <!-- Ikony Bootstrap -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Inzynierka.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <!-- Zmieniony pasek na ciemny motyw z głównym kolorem aplikacji (bg-primary) -->
        <nav class="navbar navbar-expand-lg bg-primary mb-4" data-bs-theme="dark">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold" asp-area="" asp-controller="Home" asp-action="Index">Inżynierka</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Strona Główna</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="" asp-controller="Properties" asp-action="Index">
                                <i class="bi bi-building"></i> Nieruchomości
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="" asp-controller="Leases" asp-action="Index">
                                <i class="bi bi-file-earmark-text"></i> Umowy (Kadry)
                            </a>
                        </li>
                        <!-- Nowa zakładka Najemcy -->
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="" asp-controller="Tenants" asp-action="Index">
                                <i class="bi bi-people"></i> Najemcy
                            </a>
                        </li>
                        <li class="nav-item ms-auto">
                            <a class="nav-link text-warning fw-bold" asp-area="" asp-controller="Tasks" asp-action="Index">
                                <i class="bi bi-kanban"></i> Tablica Zadań
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted mt-5 pt-3">
        <div class="container text-center">
            &copy; 2026 - Inżynierka - Nowaczyk, Bajno, Kowalczyk
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
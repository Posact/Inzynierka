@model Inzynierka.Models.Property
@{
    ViewData["Title"] = "Dodaj Nieruchomość";
}

<div class="container mt-4">
    <h2 class="mb-4">Dodaj nową nieruchomość</h2>

    <div class="row">
        <div class="col-lg-8">
            <form asp-action="Create" class="card border-0 shadow-sm p-4 bg-light">
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label asp-for="Name" class="form-label fw-bold">Nazwa obiektu (np. Mieszkanie Centrum)</label>
                        <input asp-for="Name" class="form-control" required />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Address" class="form-label fw-bold">Pełny adres</label>
                        <input asp-for="Address" class="form-control" required />
                        <span asp-validation-for="Address" class="text-danger small"></span>
                    </div>
                </div>

                <hr class="text-muted" />

                <!-- Nowe pola parametrów mieszkania -->
                <div class="row mb-4">
                    <div class="col-md-4">
                        <label asp-for="Area" class="form-label fw-bold">Metraż (m²)</label>
                        <input asp-for="Area" type="number" step="0.01" class="form-control" required />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="RoomCount" class="form-label fw-bold">Liczba pokoi</label>
                        <input asp-for="RoomCount" type="number" class="form-control" required />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Floor" class="form-label fw-bold">Piętro</label>
                        <input asp-for="Floor" type="number" class="form-control" placeholder="np. 0, 2, 5" />
                    </div>
                </div>

                <!-- Suwak dla balkonu -->
                <div class="form-check form-switch mb-4">
                    <input class="form-check-input fs-5" type="checkbox" role="switch" asp-for="HasBalcony" id="hasBalconySwitch">
                    <label class="form-check-label fs-5 ms-2" for="hasBalconySwitch">Nieruchomość posiada balkon</label>
                </div>

                <div>
                    <button type="submit" class="btn btn-primary px-4"><i class="bi bi-save"></i> Zapisz do bazy</button>
                    <a asp-action="Index" class="btn btn-outline-secondary ms-2">Anuluj</a>
                </div>
            </form>
        </div>
    </div>
</div>
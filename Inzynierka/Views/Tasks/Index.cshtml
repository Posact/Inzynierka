@model IEnumerable<Inzynierka.Models.TaskItem>

@{
    ViewData["Title"] = "Tablica Zadań";
    var todoTasks = Model.Where(t => t.Status == "Do zrobienia");
    var inProgressTasks = Model.Where(t => t.Status == "W toku");
    var doneTasks = Model.Where(t => t.Status == "Zakończone");
}

<div class="container-fluid mt-4">
    <h2 class="mb-4">Zarządzanie Najmami</h2>

    <div class="row">
        <div class="col-md-4">
            <div class="card bg-light">
                <div class="card-header font-weight-bold">Do zrobienia (@todoTasks.Count())</div>
                <div class="card-body">
                    @foreach (var task in todoTasks)
                    {
                        <div class="card mb-3 shadow-sm border-danger">
                            <div class="card-body p-3">
                                <h6>@task.Title</h6>
                                <p class="text-muted small mb-1">Obiekt: @task.Property?.Name</p>
                                <p class="small text-danger mb-0">Termin: @task.DueDate.ToShortDateString()</p>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card bg-light">
                <div class="card-header font-weight-bold">W toku (@inProgressTasks.Count())</div>
                <div class="card-body">
                    @foreach (var task in inProgressTasks)
                    {
                        <div class="card mb-3 shadow-sm border-warning">
                            <div class="card-body p-3">
                                <h6>@task.Title</h6>
                                <p class="text-muted small mb-0">Obiekt: @task.Property?.Name</p>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card bg-light">
                <div class="card-header font-weight-bold">Zakończone (@doneTasks.Count())</div>
                <div class="card-body">
                    @foreach (var task in doneTasks)
                    {
                        <div class="card mb-3 shadow-sm border-success">
                            <div class="card-body p-3">
                                <h6 class="text-success">@task.Title</h6>
                                <p class="text-muted small mb-0">Obiekt: @task.Property?.Name</p>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
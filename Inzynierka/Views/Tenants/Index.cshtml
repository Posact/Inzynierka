@model IEnumerable<Inzynierka.Models.Tenant>
@{
    ViewData["Title"] = "Najemcy";
}

<div class="container mt-4">
    <h2 class="mb-4">Baza Najemców</h2>
    <a asp-action="Create" class="btn btn-success mb-3"><i class="bi bi-person-plus"></i> Dodaj Najemcę</a>

    <table class="table table-hover shadow-sm bg-white rounded">
        <thead class="table-light">
            <tr>
                <th>Imię i Nazwisko</th>
                <th>Telefon</th>
                <th>E-mail</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="fw-bold">@item.FullName</td>
                    <td>@item.PhoneNumber</td>
                    <td>@item.Email</td>
                </tr>
            }
        </tbody>
    </table>
</div>
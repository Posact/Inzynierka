@model Inzynierka.Models.Lease
@{
    ViewData["Title"] = "Nowa Umowa";
}

<div class="container mt-4">
    <h2 class="mb-4">Zarejestruj nową umowę</h2>

    <div class="row">
        <div class="col-md-8">
            <form asp-action="Create" class="card border-0 shadow-sm p-4 bg-light">

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label asp-for="PropertyId" class="form-label fw-bold">Nieruchomość</label>
                        <select asp-for="PropertyId" class="form-select" asp-items="ViewBag.PropertyId">
                            <option value="">-- Wybierz obiekt --</option>
                        </select>
                        <span asp-validation-for="PropertyId" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="TenantId" class="form-label fw-bold">Najemca</label>
                        <select asp-for="TenantId" class="form-select" asp-items="ViewBag.TenantId">
                            <option value="">-- Wybierz najemcę --</option>
                        </select>
                        <span asp-validation-for="TenantId" class="text-danger small"></span>
                    </div>
                </div>

                <hr class="text-muted" />

                <div class="row mb-4">
                    <div class="col-md-4">
                        <label asp-for="MonthlyRent" class="form-label fw-bold">Miesięczny czynsz (PLN)</label>
                        <input asp-for="MonthlyRent" type="number" step="0.01" class="form-control" required />
                        <span asp-validation-for="MonthlyRent" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="StartDate" class="form-label fw-bold">Data rozpoczęcia</label>
                        <input asp-for="StartDate" type="date" class="form-control" required />
                        <span asp-validation-for="StartDate" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="EndDate" class="form-label fw-bold">Data zakończenia</label>
                        <input asp-for="EndDate" type="date" class="form-control" required />
                        <span asp-validation-for="EndDate" class="text-danger small"></span>
                    </div>
                </div>

                <div>
                    <button type="submit" class="btn btn-primary px-4"><i class="bi bi-save"></i> Utwórz umowę</button>
                    <a asp-action="Index" class="btn btn-outline-secondary ms-2">Anuluj</a>
                </div>
            </form>
        </div>
    </div>
</div>